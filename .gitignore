__pycache__/
*.pyc
.vscode/

# a virtual environment made in the project folder (see "Installing on a new computer" in README.md)
.venv/

# the configuration of the user: the saved inputs, the profiles and the camera presets of their own
config/

# what the program writes: the results of the runs (reflectance images, result and provenance files, the regions of the panel)
results/

# files written by using the tools elsewhere (and the configuration that earlier versions kept in the project folder)
radiometric_inputs.json
panel_regions.json
radiometric_result.json
*_provenance.json
